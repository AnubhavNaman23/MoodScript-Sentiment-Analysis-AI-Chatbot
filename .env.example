# ─────────────────────────────────────────────────────────────
# MoodScript — shared environment configuration
# Copy this file to `.env` and fill in your PostgreSQL password.
# All four services read from this single source of truth.
# ─────────────────────────────────────────────────────────────

# --- PostgreSQL (already running as service postgresql-x64-18) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=moodscript
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_your_postgres_password

# --- Shared auth secret (Java signs, Node verifies) ---
# Use a long random string. Must be identical across services.
JWT_SECRET=moodscript-super-secret-change-me-to-a-long-random-string-1234567890
JWT_EXPIRES_MINUTES=1440

# --- Service ports ---
JAVA_PORT=8080
FLASK_PORT=8000
GATEWAY_PORT=8090
FRONTEND_PORT=5173

# --- Cross-service URLs ---
JAVA_API_URL=http://localhost:8080
FLASK_URL=http://localhost:8000
GATEWAY_URL=http://localhost:8090
OLLAMA_URL=http://localhost:11434

# --- Ollama models ---
OLLAMA_CHAT_MODEL=rant-ai
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# --- Frontend (Vite reads VITE_* at build time) ---
VITE_API_URL=http://localhost:8080
VITE_GATEWAY_URL=http://localhost:8090
